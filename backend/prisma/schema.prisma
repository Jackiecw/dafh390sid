// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql" // 您的数据库类型
  url      = env("DATABASE_URL")
}

// --- 1. 用户模型 (不变) ---
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  nickname     String
  createdAt    DateTime @default(now())
  role         Role     @relation(fields: [roleId], references: [id])
  roleId       String
  
  // (关系不变)
  salesData     SalesData[]
  weeklyReports WeeklyReport[]
}

// --- 2. 角色模型 (不变) ---
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  users       User[]
  menus       MenuItem[]
}

// --- 3. 菜单项模型 (不变) ---
model MenuItem {
  id    String @id @default(cuid())
  key   String @unique
  name  String
  roles Role[]
}

// --- 4. 【新增】商品模型 (Product) ---
model Product {
  id          String    @id @default(cuid())
  sku         String    @unique // (来自您的"型号") e.g., "AV-P001"
  name        String    // (补充) 易读名称 e.g., "Aviewlux S1 Pro 投影仪"
  category    ProductCategory // (补充) 品类
  imageUrl    String?   // (来自您的"图片")
  description String?   @db.Text // (来自您的"配置简述")
  cost        Float     // (来自您的"采购价")
  weightKg    Float?    // (补充) 重量 (公斤)
  volumeM3    Float?    // (来自您的"体积") 体积 (立方米 m³)

  // (新) 关系：此商品出现在多少条销售记录中
  salesData SalesData[]
}

// --- 5. 【新增】店铺模型 (Store) ---
model Store {
  id              String   @id @default(cuid())
  name            String   @unique // (来自您的"店铺编号") e.g., "Shopee 印尼 Mall 店"
  platform        Platform // (来自您的"平台")
  country         Country  // (来自您的"国家")
  platformStoreId String?  // (补充) 店铺在平台上的真实 ID
  status          StoreStatus // (来自您的"状态")
  registeredAt    DateTime? // (来自您的"注册时间")

  // (新) 关系：此店铺产生了多少条销售记录
  salesData SalesData[]
}

// --- 6. 【重大修改】销售数据模型 (SalesData) ---
model SalesData {
  id          String   @id @default(cuid())
  recordDate  DateTime
  salesVolume Int
  revenue     Float
  adSpend     Float
  createdAt   DateTime @default(now())

  // --- (旧字段已被移除) ---
  // platform     String  (REMOVED)
  // storeName    String  (REMOVED)
  // country      String  (REMOVED)
  // productSku   String? (REMOVED)
  
  // --- (关系字段) ---
  // (不变) 关联到创建者
  enteredBy   User   @relation(fields: [enteredById], references: [id])
  enteredById String

  // (新) 关联到店铺 (必需)
  store       Store  @relation(fields: [storeId], references: [id])
  storeId     String

  // (新) 关联到商品 (可选, 允许只录入店铺总销售额)
  product     Product? @relation(fields: [productId], references: [id])
  productId   String?
}

// --- 7. (不变) 周报模型 (WeeklyReport) ---
model WeeklyReport {
  id                  String   @id @default(cuid())
  weekStartDate       DateTime
  summaryThisWeek     String   @db.Text
  planNextWeek        String   @db.Text
  problemsEncountered String?  @db.Text
  other               String?  @db.Text
  createdAt           DateTime @default(now())
  author              User     @relation(fields: [authorId], references: [id])
  authorId            String
}

// --- 8. 【新增】枚举 (Enums) ---

// (用于 Store 表)
enum Platform {
  SHOPEE
  TIKTOK_SHOP
  LAZADA
  WEBSITE
  OTHER
}

enum Country {
  ID // Indonesia
  TH // Thailand
  VN // Vietnam
  MY // Malaysia
  PH // Philippines
  SG // Singapore
  OTHER
}

enum StoreStatus {
  ACTIVE   // 活跃
  INACTIVE // 未活跃
  BANNED   // 被封
  CLOSED   // 已关闭
}

// (用于 Product 表)
enum ProductCategory {
  PROJECTOR // 投影仪
  SCREEN    // 幕布
  STAND     // 支架
  ACCESSORY // 配件
  OTHER
}