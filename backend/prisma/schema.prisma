// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql" // 您的数据库类型
  url      = env("DATABASE_URL")
}

// --- 1. 用户模型 (更新) ---
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  nickname     String
  createdAt    DateTime @default(now())

  role         Role     @relation(fields: [roleId], references: [id])
  roleId       String
  
  // (关系不变)
  salesData     SalesData[]
  weeklyReports WeeklyReport[]

  // ⬇️ 【新增】 主管和运营的国家
  supervisedCountries ManagedCountry[] @relation("CountrySupervisors")
  operatedCountries   ManagedCountry[] @relation("CountryOperators")
}

// --- 2. 角色模型 (不变) ---
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  users       User[]
  menus       MenuItem[]
}

// --- 3. 菜单项模型 (不变) ---
model MenuItem {
  id    String @id @default(cuid())
  key   String @unique
  name  String
  roles Role[]
}

// --- 4. 商品模型 (Product) ---
// (已删除)

// --- 5. 店铺模型 (Store) (更新) ---
model Store {
  id              String   @id @default(cuid())
  name            String   @unique
  platform        Platform
  platformStoreId String?
  status          StoreStatus
  registeredAt    DateTime?

  country     ManagedCountry @relation(fields: [countryCode], references: [code])
  countryCode String

  salesData SalesData[]

  // ⬇️ 【新增】 与商品的多对多关系
  products Product[] @relation("StoreProducts")
}

// --- 6. 销售数据模型 (SalesData) ---
model SalesData {
  id          String   @id @default(cuid())
  recordDate  DateTime
  salesVolume Int
  revenue     Float
  // adSpend     Float  // ⬅️ 【删除】
  createdAt   DateTime @default(now())

  enteredBy   User   @relation(fields: [enteredById], references: [id])
  enteredById String

  store   Store  @relation(fields: [storeId], references: [id])
  storeId String

  // ⬇️ 【新增】 重新关联商品
  product     Product @relation(fields: [productId], references: [id])
  productId   String
}

// --- 7. (不变) 周报模型 (WeeklyReport) ---
model WeeklyReport {
  id                  String   @id @default(cuid())
  weekStartDate       DateTime
  summaryThisWeek     String   @db.Text
  planNextWeek        String   @db.Text
  problemsEncountered String?  @db.Text
  other               String?  @db.Text
  createdAt           DateTime @default(now())
  author              User     @relation(fields: [authorId], references: [id])
  authorId            String
}


// ⬇️ 【新增】 国家管理模型
model ManagedCountry {
  id            String    @id @default(cuid())
  code          String    @unique // 国家的唯一标识, e.g., "ID"
  name          String    // 国家的易读名称, e.g., "Indonesia"
  establishedAt DateTime? // 设立时间

  // --- 关系字段 ---
  
  // 1. "负责人" (多对多)
  supervisors User[] @relation("CountrySupervisors")
  
  // 2. "运营人" (多对多)
  operators   User[] @relation("CountryOperators")
  
  // 3. 关联到店铺
  stores      Store[]
}

// ⬇️ --- 【新增】 商品模型 ---
model Product {
  id          String  @id @default(cuid())
  sku         String  @unique // 商品SKU (型号)
  name        String  // 商品可读名称
  description String? @db.Text
  imageUrl    String? // 图片URL (将存储相对路径)
  
  category    ProductCategory // 商品分类

  cost        Float?  // 成本价
  weightKg    Float?  // 重量

  // 关系
  stores    Store[]     @relation("StoreProducts")
  salesData SalesData[]
}


// --- 8. 枚举 (Enums) ---

// (用于 Store 表)
enum Platform {
  SHOPEE
  TIKTOK_SHOP
  LAZADA
  WEBSITE
  OTHER
}

// (用于 Store 表)
enum StoreStatus {
  ACTIVE   // 活跃
  INACTIVE // 未活跃
  BANNED   // 被封
  CLOSED   // 已关闭
}

// ⬇️ 【新增】 商品分类枚举
enum ProductCategory {
  PROJECTOR
  SCREEN
  STAND
  ACCESSORY
  OTHER
}