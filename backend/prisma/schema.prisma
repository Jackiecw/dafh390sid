// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql" // 您的数据库类型
  url      = env("DATABASE_URL")
}

// --- 1. 用户模型 (不变) ---
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  nickname     String
  createdAt    DateTime @default(now())
 
  role         Role     @relation(fields: [roleId], references: [id])
  roleId       String
  
  // (关系不变)
  salesData     SalesData[]
  weeklyReports WeeklyReport[]
}

// --- 2. 角色模型 (不变) ---
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  users       User[]
  menus       MenuItem[]
}

// --- 3. 菜单项模型 (不变) ---
model MenuItem {
  id    String @id @default(cuid())
  key   String @unique
  name  String
  roles Role[]
}

// --- 4. 商品模型 (Product) ---
// (已删除)

// --- 5. 店铺模型 (Store) ---
model Store {
  id              String   @id @default(cuid())
  name            String   @unique // e.g., "Shopee 印尼 Mall 店"
  platform        Platform
  country         Country
  platformStoreId String?  // 店铺在平台上的真实 ID
  status          StoreStatus
  registeredAt    DateTime?  // 注册时间

  // 关系：此店铺产生了多少条销售记录
  salesData SalesData[]
}

// --- 6. 销售数据模型 (SalesData) ---
model SalesData {
  id          String   @id @default(cuid())
  recordDate  DateTime
  salesVolume Int
  revenue     Float
  adSpend     Float
  createdAt   DateTime @default(now())

  // --- (旧字段已被移除) ---
  // platform     String  (REMOVED)
  // storeName    String  (REMOVED)
  // country      String  (REMOVED)
  // productSku   String? (REMOVED)
  
  // --- (关系字段) ---
  // (不变) 关联到创建者
  enteredBy   User   @relation(fields: [enteredById], references: [id])
  enteredById String

  // (新) 关联到店铺 (必需)
  store       Store  @relation(fields: [storeId], references: [id])
  storeId     String

  // (已删除) 关联到商品
}

// --- 7. (不变) 周报模型 (WeeklyReport) ---
model WeeklyReport {
  id                  String   @id @default(cuid())
  weekStartDate       DateTime
  summaryThisWeek     String   @db.Text
  planNextWeek        String   @db.Text
  problemsEncountered String?  @db.Text
  other               String?  @db.Text
  createdAt           DateTime @default(now())
  author              User     @relation(fields: [authorId], references: [id])
  authorId            String
}

// --- 8. 枚举 (Enums) ---

// (用于 Store 表)
enum Platform {
  SHOPEE
  TIKTOK_SHOP
  LAZADA
  WEBSITE
  OTHER
}

enum Country {
  ID // Indonesia
  TH // Thailand
  VN // Vietnam
  MY // Malaysia
  PH // Philippines
  SG // Singapore
  OTHER
}

enum StoreStatus {
  ACTIVE   // 活跃
  INACTIVE // 未活跃
  BANNED   // 被封
  CLOSED   // 已关闭
}

// (ProductCategory 枚举已被删除)