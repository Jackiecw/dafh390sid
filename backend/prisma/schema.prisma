// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql" // 您的数据库类型
  url      = env("DATABASE_URL")
}

// --- 1. 用户模型 (更新) ---
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  nickname     String
  createdAt    DateTime @default(now())

  role         Role     @relation(fields: [roleId], references: [id])
  roleId       String
  
  // (关系不变)
  salesData     SalesData[]
  weeklyReports WeeklyReport[]

  // ⬇️ 【新增】 主管和运营的国家
  supervisedCountries ManagedCountry[] @relation("CountrySupervisors")
  operatedCountries   ManagedCountry[] @relation("CountryOperators")
}

// --- 2. 角色模型 (不变) ---
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  users       User[]
  menus       MenuItem[]
}

// --- 3. 菜单项模型 (不变) ---
model MenuItem {
  id    String @id @default(cuid())
  key   String @unique
  name  String
  roles Role[]
}

// --- 4. 商品模型 (Product) ---
// (已删除)

// --- 5. 店铺模型 (Store) (更新) ---
model Store {
  id              String   @id @default(cuid())
  name            String   @unique // e.g., "Shopee 印尼 Mall 店"
  platform        Platform      // (不变) Platform 枚举
  platformStoreId String?       // 店铺在平台上的真实 ID
  status          StoreStatus   // (不变) StoreStatus 枚举
  registeredAt    DateTime?     // 注册时间

  // ⬇️ 【重大修改】
  // 不再使用 Country 枚举，而是关联到新的 ManagedCountry 模型
  country         ManagedCountry @relation(fields: [countryCode], references: [code])
  countryCode     String         // e.g., "ID", "VN" (这是外键)

  // 关系：此店铺产生了多少条销售记录
  salesData SalesData[]
}

// --- 6. 销售数据模型 (SalesData) ---
// (不变)
model SalesData {
  id          String   @id @default(cuid())
  recordDate  DateTime
  salesVolume Int
  revenue     Float
  adSpend     Float
  createdAt   DateTime @default(now())

  // (不变) 关联到创建者
  enteredBy   User   @relation(fields: [enteredById], references: [id])
  enteredById String

  // (不变) 关联到店铺 (必需)
  store       Store  @relation(fields: [storeId], references: [id])
  storeId     String
}

// --- 7. (不变) 周报模型 (WeeklyReport) ---
model WeeklyReport {
  id                  String   @id @default(cuid())
  weekStartDate       DateTime
  summaryThisWeek     String   @db.Text
  planNextWeek        String   @db.Text
  problemsEncountered String?  @db.Text
  other               String?  @db.Text
  createdAt           DateTime @default(now())
  author              User     @relation(fields: [authorId], references: [id])
  authorId            String
}


// ⬇️ 【新增】 国家管理模型
model ManagedCountry {
  id            String    @id @default(cuid())
  code          String    @unique // 国家的唯一标识, e.g., "ID"
  name          String    // 国家的易读名称, e.g., "Indonesia"
  establishedAt DateTime? // 设立时间

  // --- 关系字段 ---
  
  // 1. "负责人" (多对多)
  supervisors User[] @relation("CountrySupervisors")
  
  // 2. "运营人" (多对多)
  operators   User[] @relation("CountryOperators")
  
  // 3. 关联到店铺
  stores      Store[]
}


// --- 8. 枚举 (Enums) ---

// (用于 Store 表)
enum Platform {
  SHOPEE
  TIKTOK_SHOP
  LAZADA
  WEBSITE
  OTHER
}

// (用于 Store 表)
enum StoreStatus {
  ACTIVE   // 活跃
  INACTIVE // 未活跃
  BANNED   // 被封
  CLOSED   // 已关闭
}

